# Executor web UI: build the Vite frontend, serve it with Caddy (static only).
# The frontend talks to the API directly and relies on the API's CORS
# middleware, so VITE_API_BASE defaults to the host-exposed API port.
FROM oven/bun:1 AS build
WORKDIR /app

COPY web/package.json web/bun.lock* ./
RUN bun install --frozen-lockfile

COPY web/ .

ARG VITE_API_BASE=http://127.0.0.1:8080
ENV VITE_API_BASE=$VITE_API_BASE
RUN bun run build

FROM caddy:2-alpine
COPY configs/caddy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv
EXPOSE 80
