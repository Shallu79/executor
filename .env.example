# Copy this file to .env and adjust. Values are picked up by docker compose
# (see docker-compose.yml) and by the binaries when run directly.

# --- Postgres (internal to the docker bridge; not exposed to the host) ---
POSTGRES_USER=minos
POSTGRES_PASSWORD=minos-secret
POSTGRES_DB=minos

# --- API gateway ---
# DSN used by the API to reach postgres. In compose this is assembled from
# the POSTGRES_* vars above; set it explicitly when running the binary
# outside compose (e.g. a managed postgres).
DATABASE_URL=postgres://minos:minos-secret@localhost:5432/minos

# Signs session tokens for the account endpoints. MUST be a long random
# string in production; tokens are invalidated if it changes.
JWT_SECRET=dev-jwt-secret-change-me

# Submission history retention: rows older than this many days are deleted
# from postgres on a background tick so the database doesn't flood.
SUBMISSION_RETENTION_DAYS=30
# How often the retention sweep runs.
CLEANUP_INTERVAL=1h

# Where the API binds (host:port).
LISTEN_ADDR=:8080

# --- Redis (internal to the docker bridge; not exposed to the host) ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Job execution ---
# Queue and result keys.
MINOS_QUEUE=minos:queue
MINOS_RESULT_PREFIX=minos:result:
# How long result keys live (abandoned results auto-expire).
RESULT_TTL=300s
# How long POST /execute blocks waiting for the worker before returning 504.
EXECUTION_TIMEOUT=30s
# Payload limits.
MAX_CODE_SIZE=65536
MAX_STDIN_SIZE=1024

# --- Worker ---
# How many jobs one worker processes in parallel.
CONCURRENCY=4
# Per-job workspace base dir (keep on tmpfs in production).
TMP_DIR=/tmp/minos
# nsjail binary path.
NSJAIL_BIN=nsjail
# Jail namespace toggles. clone_newnet=true gives a network-less jail on
# runc/bare-metal; keep false only to match the gVisor-compat test setup.
NSJAIL_CLONE_NEWNET=false
NSJAIL_CLONE_NEWPID=false
NSJAIL_CLONE_NEWCGROUP=false
